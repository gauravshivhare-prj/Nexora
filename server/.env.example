# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Trust forwarded client IP headers only when the deployment proxy is known.
# Use false for direct/local traffic, true or a hop count behind a proxy.
TRUST_PROXY=false
MONGODB_URI=

# --- Authentication -----------------------------------------------------
# Required. The server refuses to start without it.
# Must be at least 32 characters and must not be a placeholder word.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT secret in each environment. Rotating it invalidates every
# token that has already been issued.
JWT_SECRET=

# Access-token lifetime: a number followed by s, m, h or d. Defaults to 1h.
JWT_EXPIRES_IN=1h

# --- AI -----------------------------------------------------------------
# Optional. Name of a registered AI provider, used for resume analysis and CareerTwin narrative.
#
# Set to "gemini" to use Google Gemini. When unset or empty, the analysis
# endpoints answer 503 "not configured". Everything else — accounts, profiles,
# storing resume text, the CareerTwin itself — works without it.
#
# There is deliberately no built-in fallback that returns canned output: it
# would make analysis look finished while inventing a student's career data,
# which is the one thing this system must never do.
#
# To add another provider, implement the AiProvider contract in
# src/services/ai/aiProvider.js, register it at startup, and set this to its
# name. Its API key belongs in its own variable, never in source.
AI_PROVIDER=

# Required when AI_PROVIDER=gemini. Google AI Studio API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Gemini model identifier. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash

# Optional. Request timeout in milliseconds. Defaults to 60000 (60s).
GEMINI_TIMEOUT_MS=60000

# --- Testing ------------------------------------------------------------
# Optional. Database used by `npm test`, which DROPS it on every run.
# Leave blank to derive it from MONGODB_URI by appending "_test" to the
# database name. Must never point at a database holding real data.
MONGODB_URI_TEST=
