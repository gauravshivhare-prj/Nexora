# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=

# --- Authentication -----------------------------------------------------
# Required. The server refuses to start without it.
# Must be at least 32 characters and must not be a placeholder word.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT secret in each environment. Rotating it invalidates every
# token that has already been issued.
JWT_SECRET=

# Access-token lifetime: a number followed by s, m, h or d. Defaults to 1h.
JWT_EXPIRES_IN=1h

# --- Testing ------------------------------------------------------------
# Optional. Database used by `npm test`, which DROPS it on every run.
# Leave blank to derive it from MONGODB_URI by appending "_test" to the
# database name. Must never point at a database holding real data.
MONGODB_URI_TEST=
